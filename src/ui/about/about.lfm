          'to the community.'
          'Further thanks go to the English Lazarus Forum and the'
          'German Firebird Forum,'
          'especially for the thorough testing by'
          'Mr. Gerd Schönfeld.'
          ''
          'Your work makes this application possible – thank you!'
        )
        Align = alClient
        Font.Height = -16
        ParentFont = False
        TabOrder = 0
      end
    end
  end
  object Timer1: TTimer
    Enabled = False
    Interval = 10
    OnTimer = Timer1Timer
    Left = 576
    Top = 304
  end
